{
  "name": "g002-roadster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker-test": "node --import tsx --import ./worker/cf-stub.mjs --test worker/invite.test.ts",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "party-server": "tsx server/server.ts",
    "party-test": "tsx scripts/party-test.ts",
    "party-browser-test": "node scripts/party-browser-test.mjs",
    "sim-test": "tsx scripts/sim-test.ts",
    "track-check": "tsx scripts/track-check.ts",
    "browser-test": "node scripts/browser-test.mjs",
    "build:kovaforge": "tsc --noEmit && BASE=/games/g002/ vite build --outDir dist-cf/games/g002 --emptyOutDir",
    "deploy:kovaforge": "npm run build:kovaforge && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "wrangler": "^4.152.0",
    "ws": "^8.22.0"
  }
}
