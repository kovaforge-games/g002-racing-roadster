{
  "name": "g002-roadster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim-test": "tsx scripts/sim-test.ts",
    "track-check": "tsx scripts/track-check.ts",
    "browser-test": "node scripts/browser-test.mjs",
    "build:kovaforge": "tsc --noEmit && BASE=/games/g002/ vite build --outDir dist-cf/games/g002 --emptyOutDir",
    "deploy:kovaforge": "npm run build:kovaforge && wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "wrangler": "^4.152.0"
  }
}
