// Deploys to https://kovaforge.org/games/g002/ (workers.dev and preview URLs are off: free plan only)
//   npm run deploy:kovaforge   (or push to main with the CLOUDFLARE_API_TOKEN repository secret set)
// The route takes precedence over the kovaforge-home Worker for this path only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g002-roadster",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "5692e8d07cc3db8bb8d81491cfb766b9",
  "assets": { "directory": "./dist-cf", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "kovaforge.org/games/g002*", "zone_name": "kovaforge.org" }
  ],
  "workers_dev": true,
  "preview_urls": false,
  // the invite gate asks the kovaforge-home hub whether a /games invite link is still live (worker/invite.ts)
  "services": [{ "binding": "HUB", "service": "kovaforge-home" }],
  // one Durable Object per multiplayer party (see worker/index.ts)
  "durable_objects": { "bindings": [{ "name": "PARTY", "class_name": "PartyRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }]
}
